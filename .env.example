# Resend (https://resend.com/api-keys). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Aiso Hiring <hiring@getaiso.com>"

# Where "interview completed" notifications go (comma-separate for several people).
ADMIN_EMAIL=ben@getaiso.com

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me

# Long random string used to sign interview links and the admin session.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# Vercel Blob store token (added automatically when you connect a Blob store on Vercel).
BLOB_READ_WRITE_TOKEN=

# Public URL of the app, used in email links. Defaults to the request host.
APP_URL=https://interview.getaiso.com

# Shown to candidates and used in question 3.
COMPANY_NAME=Aiso
